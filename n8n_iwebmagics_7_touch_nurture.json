{
  "name": "iWebMagics 7-Touch WhatsApp Template Nurture Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger-node",
      "name": "Every Hour Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jncmizoejeaclpnfxazg.supabase.co/rest/v1/rpc/get_due_scheduled_drips",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"p_org_id\": \"f452203e-c1b4-49c9-87c7-2b7d7a4ce2e2\"\n}",
        "options": {}
      },
      "id": "get-due-drips-node",
      "name": "Fetch Due Scheduled Drips",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const d = item.json;\n  const step = d.touch_step || 1;\n  const name = d.lead_name || 'Customer';\n  const meta = d.lead_metadata || {};\n  const industry = meta.industry || 'Business';\n  const bizName = meta.business_name || 'Your Business';\n  const link1 = meta.demo_link_1 || 'https://iwebmagics.com/demo1';\n  const link2 = meta.demo_link_2 || 'https://iwebmagics.com/demo2';\n  const link3 = meta.demo_link_3 || 'https://iwebmagics.com/demo3';\n  \n  const templateName = `touch_${step}`;\n  let parameters = [];\n  \n  if (step === 1) {\n    // touch_1: {{1}} name, {{2}} business_name, {{3}} industry, {{4}} link1, {{5}} link2, {{6}} link3\n    parameters = [\n      { type: 'text', text: name },\n      { type: 'text', text: bizName },\n      { type: 'text', text: industry },\n      { type: 'text', text: link1 },\n      { type: 'text', text: link2 },\n      { type: 'text', text: link3 }\n    ];\n  } else if (step === 3) {\n    // touch_3: {{1}} name, {{2}} industry\n    parameters = [\n      { type: 'text', text: name },\n      { type: 'text', text: industry }\n    ];\n  } else {\n    // touch_2, touch_4, touch_5, touch_6, touch_7: {{1}} name, {{2}} business_name\n    parameters = [\n      { type: 'text', text: name },\n      { type: 'text', text: bizName }\n    ];\n  }\n  \n  return {\n    json: {\n      drip_id: d.drip_id,\n      lead_id: d.lead_id,\n      phone_number: String(d.phone_number).replace(/\\D/g, ''),\n      touch_step: step,\n      template_name: templateName,\n      template_parameters: parameters\n    }\n  };\n});"
      },
      "id": "prepare-template-payload-node",
      "name": "Format Meta Template Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/YOUR_WHATSAPP_PHONE_NUMBER_ID/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_WHATSAPP_SYSTEM_USER_TOKEN"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"={{ $json.phone_number }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"={{ $json.template_name }}\",\n    \"language\": {\n      \"code\": \"en\"\n    },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": ={{ JSON.stringify($json.template_parameters) }}\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "send-meta-template-node",
      "name": "Send Meta Approved WhatsApp Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://jncmizoejeaclpnfxazg.supabase.co/rest/v1/scheduled_drips?id=eq.{{ $json.drip_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"status\": \"sent\",\n  \"updated_at\": \"={{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "mark-drip-sent-node",
      "name": "Mark Drip as Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1080,
        300
      ]
    }
  ],
  "connections": {
    "Every Hour Check": {
      "main": [
        [
          {
            "node": "Fetch Due Scheduled Drips",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Scheduled Drips": {
      "main": [
        [
          {
            "node": "Format Meta Template Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Meta Template Payload": {
      "main": [
        [
          {
            "node": "Send Meta Approved WhatsApp Template",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Meta Approved WhatsApp Template": {
      "main": [
        [
          {
            "node": "Mark Drip as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
